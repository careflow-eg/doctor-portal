# CareFlow Doctor Portal — required environment variables.
#
# Copy to .env.local for development. Every variable here is NEXT_PUBLIC_* and is
# therefore inlined into the client bundle at build time — never put a secret here.
#
# The app throws at build/import time if any is missing. That is deliberate: a
# hardcoded fallback would let a misconfigured build reach live patient data while
# appearing healthy. On Vercel, set these under Project → Settings → Environment
# Variables for every environment (Production, Preview, Development).

# API Gateway (workflow-orchestrator). No trailing slash.
# Local default from workflow-orchestrator/docker-compose.yml (8000:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base for the live history interview — same host as the API.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# MedSAM2 segmentation service, used by the radiology region picker.
# Its compose file binds ${PORT:-8000}, which collides with the gateway locally,
# so run it with an explicit PORT (e.g. PORT=8004) and match it here.
NEXT_PUBLIC_MEDSAM2_API_URL=http://localhost:8004
